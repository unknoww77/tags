# Domínio público usado pelo Caddy (plataforma).
# Em produção atrás do Cloudflare Flexible para custom domains, use :80 no catch-all.
APP_DOMAIN=top1tags.dev

# URL pública da plataforma
APP_URL=https://top1tags.dev
PLATFORM_DOMAIN=top1tags.dev

# PostgreSQL
DATABASE_URL=postgresql://top1tags:top1tags@postgres:5432/top1tags?schema=public

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET=troque-por-um-segredo-longo

# Super admin inicial (seed — só na PRIMEIRA bootstrap, se ainda não existe SUPER_ADMIN)
# Em produção: obrigatório no primeiro deploy; deploys seguintes ignoram alterações aqui.
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_EMAIL=admin@top1tags.dev
SUPER_ADMIN_NAME=Super Admin
# Mín. 12 caracteres; placeholders são rejeitados (ex.: CHANGE_ME_BEFORE_FIRST_BOOT)
SUPER_ADMIN_PASSWORD=CHANGE_ME_BEFORE_FIRST_BOOT

# Cloudflare (conta master)
# Opção 1 (recomendada): Account API Token com:
#   Account → Account Settings → Edit
#   Zone → Zone → Edit
#   Zone → Zone Settings → Edit
#   Zone → DNS → Edit
#   Zone Resources → All zones
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Opção 2 (sempre cria zone): Global API Key
# My Profile → API Tokens → Global API Key + e-mail da conta
# CLOUDFLARE_EMAIL=seu@email.com
# CLOUDFLARE_API_KEY=sua_global_api_key

# Cron de validação de nameservers
CRON_SECRET=troque-cron-secret

# IP público da VPS — registros A dos custom domains (Cloudflare proxied)
ORIGIN_IP=111.90.148.173

# Salt para hash de IP no tracking
TRACKING_IP_SALT=troque-tracking-salt

# Push GitHub da VPS/Cursor (scripts/publish.mjs) — NÃO commitar o token
# Fine-grained PAT: Contents Read/Write + Actions Read/Write no repo
GIT_PUSH_TOKEN=
GITHUB_REPO=unknoww77/tags
