# Domínio público usado pelo Caddy (plataforma).
# Em produção atrás do Cloudflare Flexible para custom domains, use :80 no catch-all.
APP_DOMAIN=top1tags.dev

# URL pública da plataforma
APP_URL=https://top1tags.dev
PLATFORM_DOMAIN=top1tags.dev

# PostgreSQL
DATABASE_URL=postgresql://top1tags:top1tags@postgres:5432/top1tags?schema=public

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET=troque-por-um-segredo-longo

# Super admin inicial (seed)
SUPER_ADMIN_EMAIL=admin@top1tags.dev
SUPER_ADMIN_PASSWORD=ChangeMeNow123!
SUPER_ADMIN_NAME=Super Admin

# Cloudflare (conta master) — token com Zone:Edit + Zone Settings:Edit
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Cron de validação de nameservers
CRON_SECRET=troque-cron-secret

# Salt para hash de IP no tracking
TRACKING_IP_SALT=troque-tracking-salt
