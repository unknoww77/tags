generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
}

enum Brand {
  conectcar
  veloe
}

enum PageStatus {
  draft
  published
  archived
}

enum NsStatus {
  pending
  active
  error
}

enum TrackEventType {
  view
  cta_click
  lead
  chat_start
}

enum LeadStatus {
  colhido
  usado
  perdido
  convertido
}

enum LeadLossReason {
  sem_contato
  sem_interesse
  duplicado
  fora_perfil
  outro
}

enum ChatConversationStatus {
  open
  closed
}

enum ChatMessageSender {
  visitor
  agent
}

model User {
  id           String    @id @default(cuid())
  username     String?   @unique
  email        String?   @unique
  name         String
  passwordHash String
  role         Role      @default(TENANT_ADMIN)
  tenantId     String?
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  accounts     Account[]
  sessions     Session[]
  chatMessages ChatMessage[]
}

model Tenant {
  id               String             @id @default(cuid())
  name             String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  users            User[]
  pages            Page[]
  invites          Invite[]
  settings         TenantSettings?
  chatConversations ChatConversation[]
}

model Invite {
  id         String    @id @default(cuid())
  token      String    @unique
  email      String?
  tenantName String?
  expiresAt  DateTime
  usedAt     DateTime?
  revokedAt  DateTime?
  createdBy  String
  tenantId   String?
  tenant     Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  @@index([token])
  @@index([expiresAt])
}

model Page {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand         Brand
  templateId    String      @default("default")
  slug          String      @unique
  title         String
  headline      String?
  description   String?
  ctaLabel      String      @default("Peça sua tag")
  ctaUrl        String
  affiliateCode String?
  status        PageStatus  @default(draft)
  configJson    Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  domains       Domain[]
  events        TrackEvent[]
  leads         Lead[]
  chatConversations ChatConversation[]

  @@index([tenantId])
  @@index([brand])
  @@index([status])
}

model Domain {
  id               String    @id @default(cuid())
  pageId           String
  page             Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  hostname         String    @unique
  cloudflareZoneId String?
  nameservers      String[]
  sslMode          String    @default("flexible")
  nsStatus         NsStatus  @default(pending)
  lastCheckedAt    DateTime?
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([pageId])
  @@index([nsStatus])
}

model TrackEvent {
  id          String         @id @default(cuid())
  pageId      String
  page        Page           @relation(fields: [pageId], references: [id], onDelete: Cascade)
  domain      String
  path        String         @default("/")
  eventType   TrackEventType
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  referrer    String?
  device      String?
  ipHash      String?
  metaJson    Json?
  createdAt   DateTime       @default(now())

  @@index([pageId, createdAt])
  @@index([domain, createdAt])
  @@index([eventType, createdAt])
}

model Lead {
  id              String     @id @default(cuid())
  pageId          String
  page            Page       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  domain          String
  name            String?
  phone           String?
  email           String?
  city            String?
  formJson        Json?
  quizJson        Json?
  mode            String     @default("contact")
  whatsappEnabled    Boolean    @default(false)
  whatsappOpened     Boolean    @default(false)
  whatsappNumberUsed String?
  status             LeadStatus     @default(colhido)
  lossReason         LeadLossReason?
  lossNote           String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  device          String?
  ipHash          String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([pageId, createdAt])
  @@index([whatsappOpened])
  @@index([status])
}

model ChatConversation {
  id            String                 @id @default(cuid())
  pageId        String
  page          Page                   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tenantId      String
  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  domain        String
  visitorName   String
  visitorPhone  String
  visitorToken  String                 @unique
  status        ChatConversationStatus @default(open)
  unreadByAgent Int                    @default(0)
  unreadByVisitor Int                  @default(0)
  leadId        String?
  lastMessageAt DateTime               @default(now())
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  messages      ChatMessage[]

  @@index([tenantId, lastMessageAt])
  @@index([pageId, lastMessageAt])
  @@index([status, lastMessageAt])
}

model ChatMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   ChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         ChatMessageSender
  body           String
  agentUserId    String?
  agentUser      User?             @relation(fields: [agentUserId], references: [id], onDelete: SetNull)
  agentName      String?
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
}

/// Configuração global (todos os tenants). Singleton id = "global".
model GlobalSettings {
  id                   String   @id @default("global")
  maxPagesPerTenant    Int      @default(20)
  leadRetentionDays    Int      @default(180)
  defaultSslMode       String   @default("flexible")
  showPartnerDisclaimer Boolean @default(true)
  notifyTelegramOnLead Boolean  @default(false)
  telegramBotToken     String?
  telegramChatId       String?
  allowTenantCustomWa  Boolean  @default(true)
  inviteDaysValid      Int      @default(7)
  notes                String?
  updatedAt            DateTime @updatedAt
  updatedBy            String?
}

/// Override por tenant (null = herda do global).
model TenantSettings {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  maxPages             Int?
  leadRetentionDays    Int?
  notifyTelegramOnLead Boolean?
  telegramChatId       String?
  disabled             Boolean  @default(false)
  notes                String?
  updatedAt            DateTime @updatedAt
  updatedBy            String?
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String?
  action     String
  targetType String?
  targetId   String?
  metaJson   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
